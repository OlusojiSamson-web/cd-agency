# VFS Global credentials
VFS_EMAIL=your_email@example.com
VFS_PASSWORD=your_vfs_password

# Appointment preferences
VFS_COUNTRY=Italy
VFS_CITY=Edinburgh
VFS_VISA_CATEGORY=Schengen Visa
# Comma-separated target months: July 2025 = 2025-07, Aug = 2025-08
TARGET_MONTHS=2025-07,2025-08

# Check interval in seconds (300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# Email notifications (uses Gmail SMTP)
NOTIFY_EMAIL=samsonsoji@gmail.com
GMAIL_USER=samsonsoji@gmail.com
# Use a Gmail App Password (not your main password)
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password

# Set to "true" to auto-book the first available slot (EXPERIMENTAL)
AUTO_BOOK=false
